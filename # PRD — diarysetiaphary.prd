tania_portrait_smile.png
tania_portrait_talking.png
tania_portrait_sad.png

bedroom_bg.png
bedroom_far.png
bedroom_mid.png
bedroom_main.png
bedroom_fg.png

garden_bg.png
garden_far.png
garden_mid.png
garden_main.png
garden_fg.png

cafe_bg.png
cafe_far.png
cafe_mid.png
cafe_main.png
cafe_fg.png

